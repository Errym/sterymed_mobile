<?xml version="1.0" encoding="utf-8"?>
<!--
  SteryMed keeps clinical traceability data (encrypted boxes, the offline
  queue, session secrets) on the phone. None of it may leave the device
  through Google cloud backup or a device-to-device transfer: a restored copy
  on another phone would carry a signed-in session and patient references
  without the keystore that protects them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
